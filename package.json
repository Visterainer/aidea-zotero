{
  "name": "aidea-for-zotero",
  "type": "module",
  "version": "3.2.4",
  "description": "AIdea: Free AI assistant for Zotero — Chat with AI directly in Zotero's side panel",
  "config": {
    "addonName": "AIdea",
    "addonID": "aidea@visterainer",
    "addonRef": "aidea",
    "addonInstance": "AIdea",
    "prefsPrefix": "extensions.zotero.aidea"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Visterainer/aidea-zotero.git"
  },
  "author": "zhile",
  "bugs": {
    "url": "https://github.com/Visterainer/aidea-zotero/issues"
  },
  "homepage": "https://github.com/Visterainer/aidea-zotero#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "test:unit": "npx tsx node_modules/mocha/bin/mocha --timeout 10000 --ignore test/startup.test.ts \"test/**/*.test.ts\"",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "katex": "^0.17.0",
    "zotero-plugin-toolkit": "^5.1.4"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "@zotero-plugin/eslint-config": "^0.6.9",
    "chai": "^6.2.2",
    "eslint": "^10.6.0",
    "mocha": "^11.7.6",
    "prettier": "^3.9.4",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "zotero-plugin-scaffold": "^0.8.7",
    "zotero-types": "^4.1.2"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
