---
import { pageContent } from "../content";
import { getLocaleDefinition, guideLocales, type Locale } from "../i18n";
import LanguageMenu from "./LanguageMenu.astro";
const { lang } = Astro.props as { lang: Locale };
const page = pageContent[lang];
const locale = getLocaleDefinition(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const docs = guideLocales.includes(lang) ? base + "/guide/" + lang + "/" : base + "/guide/";
const repo = "https://github.com/Visterainer/aidea-zotero";
const release = repo + "/releases/latest";
const demos = [
  { id: "story", tab: page.chat, title: page.chatHeading, text: page.chatText, src: locale.usesChineseMedia ? "reader/chat-zh-CN.jpg" : "reader/window-chat-en-US.jpg" },
  { id: "selection", tab: page.selection, title: page.selectionHeading, text: page.selectionText, src: locale.usesChineseMedia ? "reader/selection-zh-CN.jpg" : "reader/window-selection-en-US.jpg" },
  { id: "factorminer-figure-1", tab: page.translation, title: page.translationHeading, text: page.translationText, src: "factorminer-figure-1-en-zh.png" },
];
---
<header class="topbar"><div class="wrap topbar-inner">
  <a class="brand" href={base + locale.href}><img src={base + "/media/icon-96.png"} width="34" height="34" alt="" /> AIdea</a>
  <nav class="toplinks"><a href={docs}>{page.guide}</a><a class="repo" href={repo}>GitHub ↗</a></nav>
  <LanguageMenu {lang} surface="home" />
</div></header>
<main class="wrap">
  <section class="intro">
    <div><p class="compat">Zotero 7–10 <span>·</span> {page.openSource}</p>
      <h1>{page.title}<em>{page.accent}</em></h1>
    </div>
    <div class="intro-actions"><p>{page.lead}</p><div class="actions">
      <a class="button primary" href={release}>{page.download} <span aria-hidden="true">↓</span></a>
      <a class="button secondary" href={docs}>{page.guide} <span aria-hidden="true">→</span></a>
    </div></div>
  </section>
  <section id="features" aria-label="AIdea">
    <nav class="demo-tabs" aria-label="Zotero">
      {demos.map(d => <a id={"tab-" + d.id} href={"#" + d.id}>{d.tab}</a>)}
    </nav>
    {demos.map((d,i) => <section class="demo" id={d.id} aria-labelledby={"title-" + d.id}>
      <div class="demo-copy"><h2 id={"title-" + d.id}>{d.title}</h2><p>{d.text}</p>
        {i === 2 && <a class="text-link" href={base + "/media/translate-example-table.png"}>{page.table} ↗</a>}
      </div>
      <figure><a href={base + "/media/" + d.src}><img src={base + "/media/" + d.src} alt={d.tab + " · " + (i === 2 ? "FactorMiner" : "Attention Is All You Need")} loading={i === 0 ? "eager" : "lazy"} width={i === 2 ? 2946 : 3600} height={i === 2 ? 1752 : 2100} /></a></figure>
    </section>)}
  </section>
  <section class="setup" id="install">
    <h2>{page.setup}</h2><div><p>{page.setupText}</p><a class="text-link" href={docs}>{page.guide} →</a></div>
  </section>
</main>
<footer class="wrap foot"><span>AIdea · Zotero</span><a href={repo}>GitHub</a><a href={repo + "/issues"}>Issues</a><a href={repo + "/blob/master/LICENSE"}>AGPL-3.0</a></footer>
<script>
  const tabs = [...document.querySelectorAll<HTMLAnchorElement>(".demo-tabs a")];
  const panels = [...document.querySelectorAll<HTMLElement>(".demo")];
  function select(tab: HTMLAnchorElement) {
    for (const item of tabs) {
      const active = item === tab;
      item.setAttribute("aria-selected", String(active));
      item.tabIndex = active ? 0 : -1;
    }
    for (const panel of panels) panel.hidden = "#" + panel.id !== tab.hash;
  }
  function selectFromHash() {
    select(tabs.find(tab => tab.hash === location.hash) ?? tabs[0]);
  }
  document.querySelector(".demo-tabs")!.setAttribute("role", "tablist");
  tabs.forEach((tab, i) => {
    tab.setAttribute("role", "tab");
    tab.setAttribute("aria-controls", panels[i].id);
    panels[i].setAttribute("role", "tabpanel");
    panels[i].setAttribute("aria-labelledby", tab.id);
    tab.addEventListener("click", event => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      select(tab);
      history.replaceState(null, "", tab.hash);
    });
    tab.addEventListener("keydown", event => {
      const delta = document.dir === "rtl" ? -1 : 1;
      const positions: Record<string, number> = { ArrowRight: i + delta, ArrowLeft: i - delta, Home: 0, End: tabs.length - 1 };
      const index = positions[event.key];
      if (index === undefined) return;
      event.preventDefault();
      const next = tabs[(index + tabs.length) % tabs.length];
      next.focus(); next.click();
    });
  });
  selectFromHash();
  window.addEventListener("hashchange", selectFromHash);
</script>
