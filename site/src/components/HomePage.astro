---
import type { HeadingKey, PageData } from "../content";
import { headingFragments } from "../content";
import { getLocaleDefinition, localeOptions } from "../i18n";

type Props = {
  page: PageData;
};

const { page } = Astro.props;
const basePath = import.meta.env.BASE_URL;
const baseRoot = basePath.endsWith("/") ? basePath : `${basePath}/`;
const withBase = (value: string) => `${baseRoot}${value.replace(/^\//, "")}`;
const locale = getLocaleDefinition(page.locale);
const docsHref = {
  en: "https://github.com/Visterainer/aidea-zotero/blob/master/README.md",
  "zh-CN":
    "https://github.com/Visterainer/aidea-zotero/blob/master/doc/readme/README.zh-CN.md",
  "zh-TW":
    "https://github.com/Visterainer/aidea-zotero/blob/master/doc/readme/README.zh-TW.md",
  ja: "https://github.com/Visterainer/aidea-zotero/blob/master/doc/readme/README.ja.md",
  ko: "https://github.com/Visterainer/aidea-zotero/blob/master/doc/readme/README.ko.md",
  fr: "https://github.com/Visterainer/aidea-zotero/blob/master/doc/readme/README.fr.md",
}[page.locale] ?? "https://github.com/Visterainer/aidea-zotero/blob/master/README.md";
const heroImage = locale.usesChineseMedia
  ? withBase("/media/chat-panel-cn.png")
  : withBase("/media/chat-panel-en.png");
const storyImage = locale.usesChineseMedia
  ? withBase("/media/story-chat-cn.png")
  : withBase("/media/story-chat-en.png");
const settingsImage = locale.usesChineseMedia
  ? withBase("/media/settings-oauth-models-cn.png")
  : withBase("/media/settings-oauth-models-en.png");
const translationImage = locale.usesChineseMedia
  ? withBase("/media/translate-panel-cn.png")
  : withBase("/media/translate-panel-en.png");
const selectionTranslationPopupImage = withBase("/media/selection-translation-popup.png");
const selectionTranslationSettingsImage = withBase("/media/selection-translation-settings.png");
const releaseHref = "https://github.com/Visterainer/aidea-zotero/releases";
const githubHref = "https://github.com/Visterainer/aidea-zotero";
const issuesHref = "https://github.com/Visterainer/aidea-zotero/issues";
const licenseHref = "https://github.com/Visterainer/aidea-zotero/blob/master/LICENSE";
const languageLabel = "Language";
const modelAccessContent = {
  "zh-CN": {
    kicker: "模型接入",
    heading: "连接模型，开始对话",
    headingAccent: "连接模型",
    headingRest: "，开始对话",
    body: "支持 OAuth 授权和 API / 本地模型接入两种方式，你可以按自己的使用习惯选择。",
    note: "之后也可以在插件设置中随时切换接入方式。",
    options: [
      {
        label: "OAuth 授权",
        tag: "推荐",
        title: "登录服务商账号，授权后即可使用",
        body: "无需手动填写 API Key，适合希望快速开始模型对话的大多数用户。",
        points: ["点击授权登录", "自动保存授权状态", "适合 OpenAI、Gemini、GitHub Copilot 等服务"],
