---
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import { getLocaleDefinition, localeDefinitions, type Locale } from "../../i18n";
import LanguageMenu from "../../components/LanguageMenu.astro";
import "../../styles/global.css";

export function getStaticPaths() {
  const sources = import.meta.glob<string>(["../../../../doc/user-guide/*.md", "!../../../../doc/user-guide/README.md"], {
    eager: true, query: "?raw", import: "default",
  });
  return localeDefinitions.map(({ code }) => {
    const source = sources[`../../../../doc/user-guide/${code}.md`];
    if (!source) throw new Error(`Missing guide for ${code}`);
    return { params: { lang: code }, props: { source } };
  });
}
const locale = getLocaleDefinition(Astro.params.lang as Locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const toolbarIcons = import.meta.glob<string>("../../../../addon/content/icons/action-*.svg", {
  eager: true, query: "?url&no-inline", import: "default",
});
const source = Astro.props.source
  .replace(/src="\.\.\/\.\.\/addon\/content\/icons\/(action-[\w-]+\.svg)"/g, (_, file) => {
    const url = toolbarIcons[`../../../../addon/content/icons/${file}`];
    if (!url) throw new Error(`Unknown toolbar icon in the user guide: ${file}`);
    return `class="guide-icon" src="${url}"`;
  })
  .replaceAll("(../../site/public/media/", `(${base}/media/`)
  .replace(/\(\.\/([\w-]+)\.md\)/g, `(${base}/guide/$1/)`);
// The Markdown edition keeps its own language row and contents for GitHub.
const [opening, contents, ...chapters] = source.split(/(?=^## )/m);
const [titleLine, , ...introduction] = opening.trim().split(/\n\s*\n/);
const title = titleLine.replace(/^# /, "");
const processor = await createMarkdownProcessor({ syntaxHighlight: false });
const [titleBlock, lead, directory, article] = await Promise.all([
  processor.render(titleLine),
  processor.render(introduction.join("\n\n")),
  processor.render(contents),
  processor.render(chapters.join("")),
]);
const contentsHeading = directory.metadata.headings[0];
type Heading = (typeof article.metadata.headings)[number];
const sections: { heading: Heading; children: Heading[] }[] = [];
for (const heading of article.metadata.headings) {
  if (heading.depth === 2) sections.push({ heading, children: [] });
  else if (heading.depth === 3) sections.at(-1)?.children.push(heading);
}
---
<!doctype html>
<html lang={locale.code} dir={locale.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={`${base}/media/icon-96.png`} />
    <title>{title}</title>
  </head>
  <body data-locale={locale.code}>
    <header class="guide-header">
      <div class="guide-bar">
        <a class="guide-brand" href={`${base}${locale.href}`}>
          <img src={`${base}/media/icon-96.png`} width="40" height="40" alt="" /> AIdea
        </a>
        <LanguageMenu lang={locale.code} surface="guide" />
      </div>
    </header>
    <div class="guide-layout">
      <aside class="guide-sidebar">
        <details id="guide-menu" open>
          <summary id={contentsHeading.slug}>{contentsHeading.text}</summary>
          <nav aria-labelledby={contentsHeading.slug} class="guide-toc">
            <ol>
              {sections.map(({ heading, children }) => (
                <li>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                  {children.length > 0 && (
                    <ul>{children.map((child) => <li><a href={`#${child.slug}`}>{child.text}</a></li>)}</ul>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        </details>
      </aside>
      <main class="guide-article">
        <header class="guide-intro">
          <h1 id={titleBlock.metadata.headings[0].slug}>{title}</h1>
          <div set:html={lead.code} />
        </header>
        <article set:html={article.code} />
      </main>
    </div>
    <script is:inline>
      const menu = document.getElementById("guide-menu");
      const compact = window.matchMedia("(max-width: 64rem)");
      const links = [...menu.querySelectorAll("nav a")];
      const headings = links.map(link => document.getElementById(decodeURIComponent(link.hash.slice(1))));
      const header = document.querySelector(".guide-header");
      const summary = menu.querySelector("summary");
      const measure = () => {
        document.documentElement.style.setProperty("--guide-menu-height", summary.offsetHeight + "px");
        scheduleUpdate();
      };
      let current = -1;
      let scheduled = false;

      function updateCurrent() {
        scheduled = false;
        const top = header.offsetHeight + (compact.matches ? summary.offsetHeight : 0) + 24;
        let index = headings.length - 1;
        while (index >= 0 && headings[index].getBoundingClientRect().top > top) index--;
        if (index === current) return;
        if (current >= 0) links[current].removeAttribute("aria-current");
        if (index >= 0) links[index].setAttribute("aria-current", "location");
        current = index;
      }

      function scheduleUpdate() {
        if (scheduled) return;
        scheduled = true;
        requestAnimationFrame(updateCurrent);
      }

      function syncLayout() {
        menu.open = !compact.matches;
        scheduleUpdate();
      }
      menu.addEventListener("click", event => {
        if (compact.matches && event.target.closest("nav a")) menu.open = false;
      });
      menu.addEventListener("keydown", event => {
        if (compact.matches && event.key === "Escape" && menu.open) {
          menu.open = false;
          menu.querySelector("summary").focus();
        }
      });
      compact.addEventListener("change", syncLayout);
      document.addEventListener("scroll", scheduleUpdate, { capture: true, passive: true });
      window.addEventListener("resize", scheduleUpdate);
      window.addEventListener("load", scheduleUpdate);
      syncLayout();
      measure();
      const observer = new ResizeObserver(measure);
      observer.observe(header);
      observer.observe(summary);
    </script>
  </body>
</html>
<style is:global>
  html { scroll-behavior: auto; --guide-menu-height: 2.4rem; }
  body { background: #fff; }
  .guide-header {
    position: sticky; top: 0; z-index: 5; height: 0; pointer-events: none;
  }
  .guide-bar {
    display: flex; align-items: flex-start; justify-content: space-between;
    gap: .75rem; padding: .65rem .75rem;
  }
  .guide-brand, .guide-bar .language-menu { pointer-events: auto; }
  .guide-brand {
    display: inline-flex; align-items: center; gap: .4rem; direction: ltr;
    font-size: 1.16rem; font-weight: 700;
  }
  .guide-bar .language-menu nav { left: auto; right: 0; width: 11rem; overflow-wrap: anywhere; }
  .guide-layout {
    display: grid; grid-template-columns: clamp(14rem, 16vw, 18rem) minmax(0, 1fr);
    grid-template-areas: "toc article"; align-items: start; gap: clamp(1rem, 2vw, 2.5rem);
    max-width: 120rem; margin-inline: auto;
    /* Leave both corner controls and the open language list outside the reading area. */
    padding-left: 8rem; padding-right: 12.75rem;
  }
  html[dir="rtl"] .guide-bar { flex-direction: row-reverse; }
  html[dir="rtl"] .guide-layout { grid-template-columns: minmax(0, 1fr) clamp(14rem, 16vw, 18rem); grid-template-areas: "article toc"; }
  .guide-sidebar {
    grid-area: toc; position: sticky; top: 0; padding-block: 1rem;
    max-height: 100vh; max-height: 100dvh; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin;
  }
  .guide-sidebar summary { cursor: pointer; font-weight: 700; color: #44372d; padding: .4rem .6rem; }
  .guide-toc ol, .guide-toc ul { list-style: none; margin: 0; padding: 0; }
  .guide-toc ol { margin-top: .6rem; }
  .guide-toc ul { margin-block: .1rem .5rem; margin-inline-start: .8rem; padding-inline-start: .55rem; border-inline-start: 1px solid #ded8d0; }
  .guide-toc a { display: block; padding: .32rem .6rem; border-radius: .3rem; line-height: 1.5; overflow-wrap: anywhere; }
  .guide-toc ol > li > a { font-weight: 600; }
  .guide-toc ul a { font-size: .88rem; color: #5e574e; }
  .guide-toc a:hover { background: #f7f4ef; }
  .guide-toc a[aria-current] { background: #f4ebe2; color: #763e21; box-shadow: inset 3px 0 #96532d; }
  .guide-article { grid-area: article; min-width: 0; padding-block: 1rem 5rem; padding-left: clamp(1rem, 2vw, 2rem); border-left: 1px solid #e3ddd5; }
  .guide-article h1, .guide-article h2 { max-width: none; }
  .guide-intro h1 { font-size: clamp(2.15rem, 3.7vw, 3.6rem); margin: .25rem 0 .75rem; line-height: 1.16; }
  .guide-intro p { color: #585048; }
  .guide-article h2 { font-size: clamp(1.5rem, 2.2vw, 2rem); margin: 2.2rem 0 .85rem; padding-top: 1.6rem; border-top: 1px solid #e3ddd5; }
  .guide-article h3 { margin: 1.5rem 0 .5rem; font-size: 1.2rem; }
  .guide-article :is(h1, h2, h3) { scroll-margin-top: 1.25rem; }
  .guide-article p, .guide-article li { max-width: 84ch; line-height: 1.75; overflow-wrap: anywhere; }
  .guide-article p:has(> a > img) { max-width: none; }
  .guide-article a > img { display: block; width: 100%; height: auto; border: 1px solid #ded8d0; border-radius: .45rem; cursor: zoom-in; }
  .guide-article .guide-icon { display: inline-block; width: 1.1em; height: 1.1em; vertical-align: -.16em; }
  .guide-article p:has(img[src*="/detail-line-height"]) {
    display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr); gap: .8rem; align-items: center;
  }
  @media (max-width: 640px) {
    .guide-article p:has(img[src*="/detail-line-height"]) { grid-template-columns: 1fr; }
  }
  .guide-article a { color: #775039; text-decoration: underline; text-underline-offset: .18em; }
  .guide-article table { width: 100%; border-collapse: collapse; }
  .guide-article th, .guide-article td { border-bottom: 1px solid #ddd; padding: .65rem; text-align: start; vertical-align: top; overflow-wrap: anywhere; }
  .guide-article blockquote { margin: 1rem 0; padding: .2rem 1.2rem; border-inline-start: .2rem solid #947159; background: #faf8f5; }
  @media screen and (max-width: 64rem) {
    body { display: grid; grid-template-rows: auto minmax(0, 1fr); height: 100vh; height: 100dvh; }
    .guide-header { position: relative; height: auto; }
    .guide-bar { align-items: flex-start; padding: .2rem .75rem; }
    .guide-bar .language-menu[open] nav {
      position: static; width: 11rem; max-height: 38vh; max-height: 38dvh; margin-top: .25rem;
    }
    .guide-bar .language-menu[open] summary { width: fit-content; margin-left: auto; }
    .guide-layout {
      display: block; width: 100%; min-height: 0; overflow: auto;
      padding-inline: 1rem; scroll-padding-top: var(--guide-menu-height);
    }
    .guide-sidebar { z-index: 2; overflow: visible; margin-inline: -1rem; padding: 0 1rem; background: #fff; border-bottom: 1px solid #e3ddd5; }
    .guide-sidebar summary { padding: .4rem 0; }
    .guide-toc { position: absolute; inset: 100% 0 auto; max-height: 65vh; max-height: 65dvh; overflow: auto; overscroll-behavior: contain; padding: .25rem 1rem .8rem; border-bottom: 1px solid #ded8d0; background: #fff; box-shadow: 0 .6rem 1rem #3b291215; }
    .guide-article { border: 0; padding: 1.4rem 0 3rem; }
    .guide-article :is(h1, h2, h3) { scroll-margin-top: 1rem; }
  }
  @media print {
    .guide-header, .guide-sidebar { display: none; }
    .guide-layout { display: block; }
    .guide-article { border: none; padding: 0; }
  }
</style>
