---
import HomePage from "../../components/HomePage.astro";
import { pageContent } from "../../content";
import { localeDefinitions } from "../../i18n";
import BaseLayout from "../../layouts/BaseLayout.astro";
export const getStaticPaths = () => localeDefinitions.map(locale => ({
  params: { locale: locale.routeSegment }, props: { locale },
}));
const { locale } = Astro.props;
const page = pageContent[locale.code];
---
<BaseLayout lang={locale.code} title="AIdea for Zotero" description={page.lead} path={locale.href}>
  <HomePage lang={locale.code} />
</BaseLayout>
